{
  "name": "@dongxuan/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm check:ui && tsc -p tsconfig.app.json --noEmit && vite build",
    "typecheck": "pnpm check:ui && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "check:ui": "node scripts/check-ui.mjs",
    "preview": "vite preview --port 5192 --strictPort"
  },
  "dependencies": {
    "@dongxuan/dto": "workspace:*",
    "@rabjs/react": "^9.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-router": "^7.13.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
