NODE_ENV=development
PORT=3048

# 开发库与生产库分开。不要把超级用户 postgres 写进应用配置。
# 主机、端口、账号和密码只放在本机 .env，不要把真实地址写进仓库。
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=dongxuan_test_user
PG_PASSWORD=
PG_DATABASE=dongxuan_test
PG_SSL=false

WEB_ORIGIN=http://127.0.0.1:5192
JWT_SECRET=replace-with-a-long-random-string
COOKIE_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# 五个都空则关闭统一登录。只填一部分会关闭并在启动日志里记下缺失的变量名。
# 生产回调必须是 https，且与 WEB_ORIGIN 同源：{WEB_ORIGIN}/api/auth/oidc/callback
# clientId 用 dongxuan，audience 用 dongxuan-api，用户属性 dongxuan_user_id。
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_AUDIENCE=
# OIDC_SCOPES=openid profile email
# 注册同步到 Keycloak 才需要。登录不需要。
# OIDC_ADMIN_USER=
# OIDC_ADMIN_PASSWORD=
