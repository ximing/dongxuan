# Copy to /root/apps/dongxuan/.env on the app server, chmod 600.
# Never copy a local test database or publish this file's real values.
PG_HOST=
PG_PORT=5432
PG_USER=dongxuan_prod_user
PG_PASSWORD=
PG_DATABASE=dongxuan_prod
PG_SSL=false
WEB_ORIGIN=https://dx.aimo.plus
JWT_SECRET=
COOKIE_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Optional SSO. All five empty means local email/password authentication.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
OIDC_AUDIENCE=
